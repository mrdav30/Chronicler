<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<LangVersion>14.0</LangVersion>
		<LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">11.0</LangVersion>
		<Configurations>Debug;Release;ReleaseLean</Configurations>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<DebugType>portable</DebugType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Chronicler.MemoryPackShim.xml</DocumentationFile>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<AssemblyName>Chronicler.MemoryPackShim</AssemblyName>
		<RootNamespace>Chronicler.MemoryPackShim</RootNamespace>
		<PackageId>Chronicler.MemoryPackShim</PackageId>
		<Authors>mrdav30</Authors>
		<Description>Shared MemoryPack compatibility attributes for Lean builds that disable the real MemoryPack package.</Description>
		<PackageTags>memorypack;lean;shim;serialization;deterministic;lockstep</PackageTags>
		<PackageProjectUrl>https://github.com/mrdav30/Chronicler</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mrdav30/Chronicler</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\COPYRIGHT" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
